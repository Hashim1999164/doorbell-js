{
  "name": "doorbell-js",
  "version": "1.12.0",
  "description": "Verify Stripe, GitHub, Slack, Shopify, Clerk, and Svix webhook signatures in Node.js. HMAC-SHA256 over the raw body, not JSON.parse. Works with Next.js, Express, Fastify, and Hono.",
  "license": "MIT",
  "type": "module",
  "author": "Hashim Khan <sardarhashim30@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hashim1999164/doorbell-js.git"
  },
  "bugs": {
    "url": "https://github.com/Hashim1999164/doorbell-js/issues"
  },
  "homepage": "https://hashim1999164.github.io/doorbell-js/",
  "keywords": [
    "webhook",
    "webhooks",
    "webhook-signature",
    "webhook-verification",
    "stripe",
    "stripe-webhooks",
    "stripe-signature",
    "constructEvent",
    "github",
    "github-webhooks",
    "x-hub-signature-256",
    "slack",
    "slack-signing-secret",
    "shopify",
    "shopify-webhooks",
    "svix",
    "clerk",
    "resend",
    "standard-webhooks",
    "paddle",
    "linear",
    "twilio",
    "meta",
    "facebook",
    "hmac",
    "hmac-sha256",
    "raw-body",
    "express",
    "nextjs",
    "fastify",
    "hono",
    "signature",
    "timing-safe"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/img"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run test:coverage && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
